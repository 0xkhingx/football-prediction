# Server-side only - FastAPI base URL used by route handlers.
API_URL=http://127.0.0.1:8000
# Optional: Plausible domain for analytics (unset = no tracking).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
# Optional: Sentry DSNs (unset = inert). Set ALLOWED_ORIGINS + RELOAD_TOKEN
# + HTTPS=1 in production. See README deploy notes.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# ALLOWED_ORIGINS=https://your-app.vercel.app
# RELOAD_TOKEN=generate-with-openssl-rand-hex-32
# HTTPS=1
